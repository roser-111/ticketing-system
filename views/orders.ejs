<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Moje zamówienia</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
</head>

<body>
  <%- include('nav') %>

  <div class="container mt-4 mb-5">
    <h1 class="mb-4">Moje zamówienia</h1>

    <% if (orders.length === 0) { %>
      <div class="alert alert-info">
        Nie masz jeszcze żadnych zamówień.
      </div>
    <% } %>

    <% orders.forEach(order => { %>
      <div class="card mb-4 shadow-sm">
        <div class="card-body">

          <h5 class="card-title">
            <%= order.title %>
          </h5>

          <p class="text-muted mb-3">
            Wydarzenie:
            <%= order.event_date.toLocaleString('pl-PL') %>
            <br>

            Zamówiono:
            <%= order.created_at.toLocaleString('pl-PL') %>
          </p>

          <h6>Zakupione miejsca:</h6>

          <ul>
            <% order.seats.forEach(seat => { %>
              <li>
                <% if (seat.section === 'FLOOR') { %>
                  Płyta (miejsca stojące)
                <% } else { %>
                  Sektor <%= seat.section %>,
                  rząd <%= seat.row_num %>,
                  miejsce <%= seat.seat_number %>
                <% } %>
              </li>
            <% }) %>
          </ul>

          <hr>

          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <strong>
              Razem: <%= order.total %> PLN
            </strong>

            <a
              href="/orders/<%= order.id %>/pdf"
              class="btn btn-primary"
            >
              Pobierz wszystkie bilety PDF
            </a>
          </div>

          <% if (order.can_cancel) { %>
            <form
              method="POST"
              action="/orders/<%= order.id %>/cancel"
              class="mt-3"
              onsubmit="return confirm('Czy na pewno anulować zamówienie?')"
            >
              <button class="btn btn-outline-danger btn-sm">
                Anuluj zamówienie
              </button>
            </form>
          <% } %>

        </div>
      </div>
    <% }) %>
  </div>
</body>
</html>
